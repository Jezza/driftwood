#!/bin/sh
# Driftwood (NVIDIA image): keep NVIDIA GPU firmware out of the initramfs.
#
# The plymouth hook copies every DRM driver into the initramfs, and each
# driver brings its firmware with it. For NVIDIA that is ~150 MiB of GSP
# firmware, which would otherwise sit in the live initrd as a second copy
# of what is already in the root filesystem.
#
# Removing it here means nouveau (or nova) loads from the root filesystem
# once it is mounted, a few seconds later; until then the boot splash runs
# on the firmware framebuffer (simpledrm). The drivers to remove are found
# by the firmware they declare, not by name, so later NVIDIA drivers are
# covered too.
#
# Ordering: hooks in /etc/initramfs-tools/hooks run after the packaged
# ones, but mkinitramfs only *queues* modules while hooks run
# (manual_add_modules) and copies them, with their firmware, after all
# hooks. So flush the queue first, then remove what we don't want;
# mkinitramfs runs depmod afterwards.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
prereqs) prereqs; exit 0 ;;
esac

. /usr/share/initramfs-tools/hook-functions

apply_add_modules

removed=0
moddir="${DESTDIR}/usr/lib/modules/${version}/kernel/drivers/gpu"
if [ -d "$moddir" ]; then
	for m in $(find "$moddir" -name '*.ko*'); do
		if modinfo -F firmware "$m" 2>/dev/null | grep -q '^nvidia/'; then
			rm -f "$m"
			removed=$((removed + 1))
		fi
	done
fi
for fw in "${DESTDIR}/usr/lib/firmware/nvidia" "${DESTDIR}/lib/firmware/nvidia"; do
	if [ -d "$fw" ] && [ ! -L "$fw" ]; then
		rm -rf "$fw"
	fi
done
echo "driftwood-nvidia-late: removed $removed NVIDIA GPU module(s) and nvidia/ firmware from the initramfs"
exit 0
