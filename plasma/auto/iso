#!/bin/sh
# live-build configuration script
# see 'man lb config'

lb config noauto \
--apt-recommends false \
--apt-source-archives false \
--apt-indices true \
--architectures amd64 \
--archive-areas 'main contrib non-free non-free-firmware' \
--backports true \
--security true \
--updates true \
--source false \
--binary-filesystem ext4 \
--chroot-squashfs-compression-type xz \
--binary-images iso-hybrid \
--checksums sha256 \
--clean \
--debconf-frontend noninteractive \
--debian-installer none \
--debootstrap-options "--include=ca-certificates,openssl" \
--distribution trixie \
--distribution-binary stable \
--firmware-binary false \
--firmware-chroot false \
--initramfs live-boot \
--iso-publisher Driftwood \
--iso-volume Driftwood_Plasma \
--linux-packages "linux-image" \
--bootappend-live "boot=live config quiet loglevel=0 splash threadirqs" \
--memtest memtest86+ \
--win32-loader false

"${@}"
