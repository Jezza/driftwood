# Firmware for desktops and laptops. live-build's --firmware-chroot would
# install every firmware package Debian has (server NICs, datacentre GPUs,
# telephony cards...), so it is off and the hardware we target is listed here.
# GPUs (NVIDIA firmware and nouveau are in plasma/variants/nvidia)
firmware-amd-graphics
firmware-intel-graphics
# Wi-Fi and Bluetooth (Intel, Atheros/Qualcomm, Realtek incl. r8169 ethernet,
# MediaTek, Broadcom, Marvell mwifiex as in Surface devices, old USB dongles)
firmware-iwlwifi
firmware-atheros
firmware-realtek
firmware-mediatek
firmware-brcm80211
firmware-libertas
firmware-ath9k-htc
firmware-carl9170
